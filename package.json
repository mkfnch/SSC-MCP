{
  "name": "securityscorecard-mcp",
  "version": "1.0.0",
  "description": "SecurityScorecard MCP Connector - Enterprise security intelligence integration for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod 755 dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp:stdio": "node dist/index.js",
    "mcp:http": "TRANSPORT_MODE=http node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "mcp",
    "securityscorecard",
    "cybersecurity",
    "security-ratings",
    "claude",
    "anthropic",
    "model-context-protocol"
  ],
  "author": "SecurityScorecard",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "pino": "^10.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
