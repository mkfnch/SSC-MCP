# SecurityScorecard MCP Connector Configuration

# Transport mode: 'stdio' or 'http' (default: stdio)
TRANSPORT_MODE=stdio

# HTTP server port (only used when TRANSPORT_MODE=http)
PORT=3000

# SecurityScorecard API Configuration
SSC_API_BASE_URL=https://api.securityscorecard.io
SSC_API_KEY=your_api_key_here

# OAuth 2.1 Configuration (for Anthropic Directory deployment)
OAUTH_ISSUER=https://auth.securityscorecard.io
OAUTH_AUDIENCE=https://mcp.securityscorecard.io
JWKS_URI=https://auth.securityscorecard.io/.well-known/jwks.json

# Logging
LOG_LEVEL=info
NODE_ENV=production
